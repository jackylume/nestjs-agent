{
  "name": "@nestjs-agent/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "pnpm db:generate",
    "dev": "pnpm db:generate && vpx --watch --env-file-if-exists=../../.env src/main.ts",
    "build": "pnpm db:generate && vp pack",
    "start": "vpx --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "pnpm db:generate && vp check --no-fmt --no-lint",
    "test": "vp test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs-agent/shared": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-node": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "nestjs-pino": "5.3.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "redis": "6.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/passport-jwt": "4.0.1",
    "prisma": "7.10.1"
  }
}
